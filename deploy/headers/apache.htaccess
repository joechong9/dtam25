# DTAM-MY security headers for Apache (mod_headers). Copy into the web root as .htaccess,
# or put the same directives in the VirtualHost. Requires: a2enmod headers
# Each page also carries its own <meta> Content-Security-Policy; browsers enforce both.
# frame-ancestors only works as an HTTP header, which is why it is set here.
<IfModule mod_headers.c>
  # Allow framing only by the same site (the dashboard embeds omr_scanner.html)
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  # Camera: OMR scanner. Microphone: Part C speech-to-text (opt-in).
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
  # Enable HSTS only once HTTPS works for the whole domain
  Header always set Strict-Transport-Security "max-age=31536000"
  # Pages: always revalidate so updates reach field devices; vendor files: long cache (pinned by SRI)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Apache 2.4: FilesMatch only sees file names, so match the vendor/ path on the request URI
  <If "%{REQUEST_URI} =~ m#/vendor/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
# Do not list directory contents
Options -Indexes
